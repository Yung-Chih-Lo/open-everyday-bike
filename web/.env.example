APP_URL=http://localhost:3000
DATABASE_PATH=./data/app.sqlite
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=ubike-private
S3_PUBLIC_BUCKET=ubike-public
S3_FORCE_PATH_STYLE=true
ASSET_PUBLIC_BASE_URL=http://localhost:9000/ubike-public
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
MODERATION_DAILY_LIMIT=100
ADMIN_PASSWORD_HASH=
RATE_LIMIT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable only when your reverse proxy replaces untrusted forwarded headers.
TRUST_PROXY=false

# Optional Jev fallback (model: ~typesafe/jev-latest)
OPENROUTER_API_KEY=
